// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    // "height": 21, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 10, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces",
        "custom/recording"
    ],
    "modules-center": [
        //"hyprland/window",
        "clock",
        "custom/media"
    ],
    "modules-right": [
        "mpd",
        "idle_inhibitor",
        "pulseaudio",
        "network",
        //"power-profiles-daemon",
        "cpu",
        "disk",
        "memory",
        "temperature",
        "backlight",
        "hyprland/language",
        //"battery",
        //"battery#bat0",
        "tray",
        "custom/power"
    ],
    // Modules configuration
    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "warp-on-scroll": true,
        "disable-scroll-wraparound": true,
        "enable-bar-scroll": true,
        "on-scroll-up": "hyprctl dispatch workspace m-1",
        "on-scroll-down": "hyprctl dispatch workspace m+1",
        "format": "{icon}",
        "format-icons": {
            "1": "1:Chrome",
            "2": "2:youwind",
            "3": "3:repero",
            "4": "4:Term",
            "5": "5:Chat",
            "6": "6:Signal",
            "7": "7:Seven",
            "8": "8:Spotify",
            "9": "9:Nine",
            "10": "10:Gimp",
            "default": "{id}"
        }
    },
    "hyprland/language": {
        "format": "{short}"
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "rewrite": {
            "^$": "Desktop"
        }
    },
    "mpd": {
        "format": "{stateIcon} {artist} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) {volume}%",
        "format-disconnected": "MPD off",
        "format-stopped": "MPD stopped",
        "unknown-tag": "N/A",
        "interval": 5,
        "state-icons": {
            "paused": "||",
            "playing": ">"
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "[on]",
            "deactivated": "[off]"
        }
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format":  "{:%d %B %H:%M}",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% cpu",
        "tooltip": false
    },
    "disk": {
        "path": "/",
        "format": "{percentage_used}% disk"
    },
    "memory": {
        "format": "{}% ram"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C",
        "format-critical": "{temperatureC}°C (!)"
    },
    "backlight": {
        "format": "{percent}% bl"
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) wifi",
        "format-ethernet": "{ipaddr}/{cidr} eth",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "{ifname} (no IP)",
        "format-disconnected": "disconnected (!)",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "{volume}% vol {format_source}",
        "format-bluetooth": "{volume}% vol-bt {format_source}",
        "format-bluetooth-muted": "muted-bt {format_source}",
        "format-muted": "muted {format_source}",
        "format-source": "{volume}% mic",
        "format-source-muted": "mic-off",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/media": {
        "format": "{text}",
        "return-type": "json",
        "max-length": 40,
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null"
    },
    "custom/recording": {
        "exec": "pgrep -x wf-recorder > /dev/null && echo '● REC' || echo ''",
        "interval": 1,
        "format": "{text}"
    },
    "custom/power": {
        "format": "PWR",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "shutdown",
            "reboot": "reboot",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate"
        }
    }
}
